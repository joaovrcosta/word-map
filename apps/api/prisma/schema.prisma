generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ContentLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model User {
  id               Int           @id @default(autoincrement())
  name             String
  email            String        @unique
  username         String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  password         String?
  googleId         String?       @unique
  resetCode        String?
  resetCodeExpires DateTime?
  role             UserRole      @default(USER)
  vaults           Vault[]
  wordHistory      WordHistory[]
  texts            Text[]
  settings         UserSettings?
  semanticConnections SemanticConnection[]
  sentences        Sentence[]
  books            Book[]
  library          UserLibrary[]
  readingProgress  ReadingProgress[]
  tutorQuota       TutorQuota?
  passageExplanations WordPassageExplanation[]
  pointAwards      PointAward[]
}

model UserSettings {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  useAllVaultsForLinks  Boolean  @default(false)
  autoTranslateWordPreview Boolean @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Vault {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  words     Word[]   @relation("VaultWords")
}

model Word {
  id               Int           @id @default(autoincrement())
  status           Boolean       @default(true)
  name             String
  grammaticalClass String
  category         String?
  translations     String[]
  notes            String?
  lastPractice     DateTime?
  confidence       Int           @default(1)
  isSaved          Boolean       @default(false)
  frequency        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  vaultId          Int
  vault            Vault         @relation("VaultWords", fields: [vaultId], references: [id], onDelete: Cascade)
  wordHistory      WordHistory[]
  Word_A           Word[]        @relation("RelatedWords")
  Word_B           Word[]        @relation("RelatedWords")
  semanticConnections SemanticConnectionWord[]
  sentenceWords    SentenceWord[]
  reviews          WordReview[]
  passageExplanations WordPassageExplanation[]
  clozes           WordCloze[]
  origins          WordOrigin[]
  pointAward       PointAward?
}

model PointAward {
  id        Int      @id @default(autoincrement())
  userId    Int
  wordId    Int?     @unique
  points    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word?    @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model WordOrigin {
  id          Int      @id @default(autoincrement())
  wordId      Int
  meaning     String
  sentence    String?  @db.Text
  sourceTitle String?
  sourceKind  String   @default("manual")
  createdAt   DateTime @default(now())
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, createdAt])
}

model WordCloze {
  id        Int      @id @default(autoincrement())
  wordId    Int
  variant   Int      @default(1)
  sentence  String   @db.Text
  answer    String
  cacheKey  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, variant])
}

model WordReview {
  id        Int      @id @default(autoincrement())
  wordId    Int
  correct   Boolean
  challenge String
  createdAt DateTime @default(now())
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model WordHistory {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int
  wordId    Int
  user      User     @relation(fields: [userId], references: [id])
  word      Word     @relation(fields: [wordId], references: [id])
}

model Text {
  id        Int           @id @default(autoincrement())
  title     String
  content   String        @db.Text
  summary   String?       @db.Text
  level     ContentLevel?
  isCatalog Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    Int
  user      User          @relation(fields: [userId], references: [id])

  @@index([isCatalog, level])
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  isOfficial  Boolean  @default(false)
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chapters    Chapter[]
  library     UserLibrary[]
}

model Chapter {
  id        Int      @id @default(autoincrement())
  bookId    Int
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  book            Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  readingProgress ReadingProgress[]
}

model ReadingProgress {
  id             Int      @id @default(autoincrement())
  userId         Int
  chapterId      Int
  pageIndex      Int
  paragraphIndex Int
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter        Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model WordPassageExplanation {
  id          Int      @id @default(autoincrement())
  userId      Int
  wordId      Int?
  passageKey  String
  span        String
  sentence    String   @db.Text
  explanation String   @db.Text
  translation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word        Word?    @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@unique([userId, passageKey])
  @@index([wordId])
}

model ReadingExplanation {
  id            Int      @id @default(autoincrement())
  cacheKey      String   @unique
  promptVersion String
  model         String
  explanation   String   @db.Text
  translation   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TutorQuota {
  userId      Int      @id
  minuteStart DateTime @default(now())
  minuteCount Int      @default(0)
  dayStart    DateTime @default(now())
  dayCount    Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLibrary {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model SemanticConnection {
  id          Int      @id @default(autoincrement())
  title       String   // Título da conexão semântica
  description String   @db.Text
  connectionType String // "semantic", "grammatical", "contextual", "opposite", "similar"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  words       SemanticConnectionWord[]
}

model SemanticConnectionWord {
  id          Int      @id @default(autoincrement())
  connectionId Int
  wordId      Int
  order       Int      // Ordem das palavras na conexão
  title       String?  // Título específico da palavra na conexão (opcional)
  description String?  // Descrição específica da palavra na conexão (opcional)
  createdAt   DateTime @default(now())
  connection  SemanticConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  
  @@unique([connectionId, wordId])
}

model Sentence {
  id        Int      @id @default(autoincrement())
  title     String?  // Título opcional da frase
  notes     String?  @db.Text // Anotações da frase
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  words     SentenceWord[]
}

model SentenceWord {
  id         Int      @id @default(autoincrement())
  sentenceId Int
  wordId     Int
  position   Int      // Posição da palavra na frase
  highlightColor String? // Cor de destaque da palavra
  createdAt  DateTime @default(now())
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  
  @@unique([sentenceId, wordId])
}
